{
  "name": "@alpina/ui",
  "version": "0.2.0",
  "description": "The flat Alpina design canon as CSS tokens, the AppShell whose module switcher reads the fleet registry, and the shadcn-style primitives every internal service shares.",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist",
    "styles"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./shell": {
      "types": "./dist/shell/app-shell.d.ts",
      "import": "./dist/shell/app-shell.js"
    },
    "./module-switcher": {
      "types": "./dist/shell/module-switcher.d.ts",
      "import": "./dist/shell/module-switcher.js"
    },
    "./cn": {
      "types": "./dist/lib/cn.d.ts",
      "import": "./dist/lib/cn.js"
    },
    "./tokens.css": "./styles/tokens.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@alpina/contracts": "workspace:*",
    "@base-ui/react": "^1.4.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.469.0",
    "react": "19",
    "react-dom": "19",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "@alpina/contracts": ">=0.1.0",
    "@base-ui/react": ">=1.4.0",
    "lucide-react": ">=0.4.0",
    "next": ">=15",
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": ">=4"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  }
}
